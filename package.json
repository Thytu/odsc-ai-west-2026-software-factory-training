{
  "name": "eventdesk",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "portless run --name eventdesk node scripts/dev.mjs",
    "setup": "portless service install",
    "context": "node scripts/environment.mjs",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "check": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/worker/tsconfig.json && tsc --noEmit -p tsconfig.scripts.json && pnpm --dir apps/web exec tsc --noEmit",
    "build": "pnpm --dir apps/web build",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@eventdesk/data": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "portless": "0.15.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "@types/pg": "8.20.0",
    "pg": "8.23.1"
  },
  "type": "module",
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "17.10.0-beta.17",
    "@embedded-postgres/darwin-x64": "17.10.0-beta.17",
    "@embedded-postgres/linux-arm": "17.10.0-beta.17",
    "@embedded-postgres/linux-arm64": "17.10.0-beta.17",
    "@embedded-postgres/linux-ia32": "17.10.0-beta.17",
    "@embedded-postgres/linux-ppc64": "17.10.0-beta.17",
    "@embedded-postgres/linux-x64": "17.10.0-beta.17",
    "@embedded-postgres/windows-x64": "17.10.0-beta.17"
  }
}
